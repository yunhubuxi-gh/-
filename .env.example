# ============================================================
# 企业私有知识库智能助手 — 环境变量模板
#
# 使用方式：
#   本地部署：  cp .env.example .env   然后按需修改
#   Docker部署： cp .env.example .env   调整数据库/向量库/前端地址后 docker compose up
#
# 说明：所有字段与 config/settings.py 的 Settings 类一一对应，
#       环境变量名不区分大小写，值通过 .env 或真实环境变量覆盖默认值。
# ============================================================


# ============================================================
# 应用基础
# ============================================================
APP_NAME=企业私有知识库智能助手平台
APP_VERSION=1.0.0
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000


# ============================================================
# 数据库连接
# ------------------------------------------------------------
# 本地开发默认 SQLite（零依赖，开箱即用）
# ============================================================
DATABASE_URL=sqlite:///./data/app.db
# 生产 / Docker 用 PostgreSQL（docker-compose 内 host 为 postgres 服务名）：
# DATABASE_URL=postgresql://kbuser:kbpass123@localhost:5432/kb_assistant
# DATABASE_URL=postgresql://kbuser:kbpass123@postgres:5432/kb_assistant

# PostgreSQL 容器初始化参数（仅供 docker-compose.yml 的 postgres 服务使用）
POSTGRES_USER=kbuser
POSTGRES_PASSWORD=kbpass123
POSTGRES_DB=kb_assistant


# ============================================================
# JWT 鉴权
# ------------------------------------------------------------
# 生产环境务必替换为足够长（>=32字节）的随机字符串
# ============================================================
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-string-32bytes-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# DeepSeek 统一配置（OpenAI 兼容协议）
# ------------------------------------------------------------
# 统一 API Key 与 Base URL，供大模型（LLM）对话调用使用。
#
# ⚠️ 重要实测结论（2026-08-15）：
#    DeepSeek 官方 API 仅提供「对话模型」deepseek-v4-flash / deepseek-v4-pro，
#    不提供 embedding（嵌入）与 rerank（重排）接口（请求返回 HTTP 404）。
#    因此本项目「嵌入」与「重排」继续使用本地 BGE 模型（见下方 embedding / rerank 段）。
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key      # ← 必填：替换为你的真实 DeepSeek Key
DEEPSEEK_BASE_URL=https://api.deepseek.com


# ============================================================
# 大模型（LLM）—— 走 DeepSeek 对话接口
# ------------------------------------------------------------
# provider=deepseek，调用 OpenAI 兼容的 /chat/completions。
# LLM_API_KEY 留空时自动回退到上面的 DEEPSEEK_API_KEY。
# ============================================================
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash            # 可选 deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60                         # 请求超时（秒）

# 其它 LLM 提供商示例（如需切换，将 LLM_PROVIDER 改为对应值并填 KEY）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key
# LLM_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-qwen-key
# LLM_MODEL=qwen-plus
#
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b


# ============================================================
# 嵌入模型（Embedding）
# ------------------------------------------------------------
# ⚠️ DeepSeek 官方不提供 embedding 接口（实测 404）。
#    这里维持本地 BGE 中文嵌入模型（sentence-transformers）。
#    bge = 本地运行（默认，零外部依赖，需联网/已缓存模型）
# ============================================================
EMBEDDING_PROVIDER=bge
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=8
# HuggingFace 模型离线加载（true=用本地缓存不联网；国内连不上 huggingface.co 时置 true）
HF_HUB_OFFLINE=true


# ============================================================
# 多模态图片向量化（可选，支持本地 Chinese-CLIP 或豆包云端）
# ------------------------------------------------------------
# 图片向量化后端二选一（图文同空间，支持「文字描述→召回图片」）：
#   local ：本地 Chinese-CLIP（modelscope 下载 + 进程内推理），无需联网/付费，但 CPU 慢（181 张图约 10 分钟）
#   doubao：豆包云端多模态向量化（火山方舟 API），快（181 张图约 10 秒），按量付费，需 DOUBAO_API_KEY
#
# 懒加载：服务启动时不加载；第一次真正处理图片时才初始化对应后端。
# 开关：ENABLE_IMAGE_EMBED=false 时完全不执行图片向量化代码路径（local 分支不导入 torch/transformers/modelscope，
#       doubao 分支不联网），系统完全退回原文本 RAG 行为，即使缺依赖也不会报错。
# ============================================================
ENABLE_IMAGE_EMBED=false                    # 图片向量化总开关
IMAGE_EMBED_PROVIDER=local                  # 图片向量化后端 local/doubao

# ---- 本地 Chinese-CLIP（IMAGE_EMBED_PROVIDER=local 时生效）----
CLIP_MODEL_NAME=damo/multi-modal_clip-vit-large-patch14_336_zh   # modelscope 模型 id 或本地目录
CLIP_DEVICE=auto                            # auto/cuda/cpu；auto 优先 cuda，无 GPU 自动降级 cpu
CLIP_MAX_IMAGE_SIDE=336                     # 图片预处理最大边长（等比例缩放，防 CLIP 推理 OOM）
CLIP_MIN_IMAGE_SIDE=32                      # 图片预处理最小边长，低于此值的极小无效图直接过滤
CLIP_DOWNLOAD_RETRY=3                       # 模型下载重试次数，全部失败则关闭图片向量化
CLIP_GC_INTERVAL=10                         # 每处理 N 张图片做一次完整内存回收（gc+empty_cache），缓解 CPU 多图内存泄漏/OOM

# ---- 豆包云端多模态向量化（IMAGE_EMBED_PROVIDER=doubao 时生效）----
DOUBAO_API_KEY=                             # 火山方舟 API Key（控制台 API Key 管理里完整复制）
# 接口地址二选一（勿混用）：
#   标准方舟（按量付费）   : https://ark.cn-beijing.volces.com/api/v3
#   Agent Plan 个人版（套餐）: https://ark.cn-beijing.volces.com/api/plan/v3（含 /plan）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215   # 豆包多模态向量化（dimensions 需 250615 及以上版本）
DOUBAO_IMAGE_EMBED_DIM=1024                 # 向量维度 1024/2048，越小越省存储与费用
DOUBAO_TIMEOUT=60                           # 单次调用超时（秒）
DOUBAO_MAX_RETRY=3                          # 限流/超时自动重试次数
DOUBAO_IMAGE_MAX_SIDE=512                   # 图片压缩最大边长（越小 token 越少越省钱，建议 448~640）

IMAGE_VECTOR_TOP_K=5                        # 图片向量召回条数

# ---- 兼容旧配置（可忽略，新项目请使用上面的 CLIP_*）----
# MULTIMODAL_EMBEDDING_MODEL=               # 旧模型名，CLIP_MODEL_NAME 未配置时回退到此项
# MULTIMODAL_EMBEDDING_DEVICE=              # 旧设备配置
# MULTIMODAL_EMBEDDING_TIMEOUT=60
# IMAGE_MAX_SIDE=                            # 旧图片最大边长，CLIP_MAX_IMAGE_SIDE 未配置时回退到此项


# ============================================================
# 向量数据库（二选一：Chroma / Milvus）
# ------------------------------------------------------------
# chroma  = 容器/本机内本地持久化（默认，零外部依赖）
# milvus  = 连接外部 Milvus 服务
# ============================================================
VECTOR_STORE_TYPE=chroma

# Chroma 配置（持久化目录；docker 容器内为 /app/data/vector_store）
CHROMA_PERSIST_DIR=./data/vector_store

# Milvus 配置（VECTOR_STORE_TYPE=milvus 时生效，指向外部 Milvus 服务）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ALIAS=default


# ============================================================
# BM25 关键词召回
# ============================================================
BM25_INDEX_DIR=./data/bm25_index
BM25_TOP_K=20


# ============================================================
# 重排模型（Rerank）
# ------------------------------------------------------------
# ⚠️ DeepSeek 官方不提供 rerank 接口（实测 404）。
#    这里维持本地 BGE-Rerank；模型缺失时自动降级为词重叠打分（OverlapReranker），
#    保证重排环节始终可用，不因模型缺失中断 RAG 链路。
# ============================================================
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=5
RERANKER_DEVICE=cpu


# ============================================================
# RAG 通用
# ============================================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SEMANTIC_CHUNK_THRESHOLD=0.75
MIN_CHUNK_SIZE=50                     # 过短块合并阈值，避免语义被切碎
VECTOR_TOP_K=20
HALLUCINATION_CHECK_ENABLED=true


# ============================================================
# RAG 召回优化（性能 + 召回率）
# ------------------------------------------------------------
# rerank 候选数：融合后送入重排的候选条数，必须 > RERANKER_TOP_N，
# 否则排序靠后的相关 chunk 进不了重排就被丢弃（「文档存在却检索不到」的常见根因）。
# ============================================================
RERANK_CANDIDATE_K=20

# 检索结果缓存（内存 TTL 缓存，重复提问直接命中，跳过检索/改写）
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=300                     # 过期时间（秒）
RAG_CACHE_MAX_SIZE=512                # 最大缓存条目数

# RAG 调试日志（打印 query 改写、向量/BM25 召回、rerank 后 chunk，排查召回失败）
RAG_DEBUG_LOG=false

# query 改写（用 LLM 生成 1~2 个衍生查询，提升召回率）
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_COUNT=2                 # 衍生查询个数（1~2）
QUERY_REWRITE_TIMEOUT=10              # 改写 LLM 超时（秒）
QUERY_REWRITE_MAX_TOKENS=1024         # 改写最大输出 token（DeepSeek 推理模型需较大值，否则 content 为空）

# 向量批量写入条数（embedding 分片 + 向量库单批写入）
VECTOR_BATCH_SIZE=256


# ============================================================
# 试卷命题 / 校验（双 Agent）配置
# ------------------------------------------------------------
# 教师发起生成试卷任务后，命题 Agent 与校验评审 Agent 串联执行：
# 命题 → 逐题校验 → 不合格题回传重生成 → 迭代至全部合格或达到最大迭代次数。
# 全部走 DeepSeek 对话接口，密钥复用上面的 DEEPSEEK_API_KEY。
# ============================================================
EXAM_MAX_ITERATE=3                  # 双 Agent 最大迭代次数（防死循环）
EXAM_LLM_TIMEOUT=120                # 出题/校验 LLM 超时（秒）
EXAM_LLM_MAX_TOKENS=4096            # 出题/校验 LLM 最大输出 token（DeepSeek 推理模型需大值，否则 content 为空）
EXAM_RAG_TOP_K=6                    # 出题/校验时 RAG 召回课件原文条数
EXAM_TEMPERATURE=0.0                # 出题/校验 LLM 温度（0=稳定）
EXAM_DEFAULT_DIFFICULTY=medium      # 试卷默认难度 easy/medium/hard

# ---- 试卷题目去重 / 知识点均衡 / 分项批改权重（上层业务迭代）----
# 校验 Agent 第 5 组校验：题目相似度去重 + 知识点均衡检测
EXAM_DUP_SIMILARITY_THRESHOLD=0.9   # 题目相似度阈值（文本向量相似度 0~1），任意两道题相似度≥该值判重复，自动重出该题
EXAM_KNOWLEDGE_MAX_RATIO=0.5        # 单个知识点题数占比上限（0~1），超过判定偏科，自动重出该知识点下多余题目
# 主观题四维度分项打分权重（支持 30/30/20/20 或 0.3/0.3/0.2/0.2，代码内自动归一化）
EXAM_GRADE_WEIGHT_KNOWLEDGE=0.3     # 知识点匹配度权重
EXAM_GRADE_WEIGHT_STEPS=0.3         # 答题步骤完整性权重
EXAM_GRADE_WEIGHT_CONCLUSION=0.2    # 结论答案正确性权重
EXAM_GRADE_WEIGHT_LANGUAGE=0.2      # 语言表述规范性权重


# ============================================================
# Agent 配置（重试次数 / 记忆窗口大小，全部配置化）
# ============================================================
AGENT_MAX_RETRY=3                      # 反思重试最大次数（防死循环）
AGENT_SHORT_TERM_MEMORY_WINDOW=10      # 短期记忆滑动窗口（消息条数）
AGENT_LONG_TERM_MEMORY_ENABLED=true    # 是否启用长期记忆

# Agent 特有补充配置（读取自 AGENT_ 前缀环境变量）
AGENT_MAX_PLAN_STEPS=5                 # 单次任务最大规划步骤数
AGENT_LONG_TERM_MAX_ITEMS=50           # 长期记忆每用户最多保留条数
AGENT_LONG_TERM_DIR=./data/long_term_memory   # 长期记忆磁盘存储目录
AGENT_LONG_TERM_TOP_K=3                # 检索长期记忆返回条数


# ============================================================
# 异步任务（大文档向量化不阻塞 HTTP）
# ------------------------------------------------------------
# background = 线程后台（开发，默认）
# celery     = 分布式（生产）
# ============================================================
ASYNC_TASK_ENGINE=background
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ============================================================
# OCR（扫描件 PDF / docx 内嵌图片文字识别）
# ============================================================
OCR_ENABLED=true
OCR_ENGINE=paddleocr
OCR_LANG=ch
OCR_CONCURRENCY=4                 # docx 大量内嵌图片并发 OCR 进程数（进程池，最终钳制 1~4；每个子进程独立 PaddleOCR）
OCR_RETRY_INTERVAL=60             # OCR 初始化失败后指数退避基础间隔（秒），退避期内不重复初始化；到期自动重试


# ============================================================
# 文件存储
# ------------------------------------------------------------
# 原始文档二进制存文件系统（三者分离：PG元数据 + 向量库 + 文件系统）
# ============================================================
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=[".pdf",".docx",".md",".txt",".png",".jpg",".jpeg"]


# ============================================================
# 日志
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=./data/logs
AUDIT_LOG_ENABLED=true


# ============================================================
# 跨域 CORS
# ============================================================
FRONTEND_URL=http://localhost:8501
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]


# ============================================================
# 前端配置
# ------------------------------------------------------------
# 前端（Streamlit）访问后端 API 的地址。
# 本地部署留空即可，前端会依据 API_HOST / API_PORT 自动派生。
# Docker 部署需显式指向后端容器：http://backend:8000
# ============================================================
FRONTEND_API_BASE_URL=
FRONTEND_TIMEOUT=60                    # 请求超时（秒）
FRONTEND_POLL_INTERVAL=1.0             # 文档/Agent 进度轮询间隔（秒）
FRONTEND_POLL_MAX_WAIT=180             # 轮询最大等待时长（秒）
